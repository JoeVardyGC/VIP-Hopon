# VIP HopOn settings. Copy to .env for local use (never commit .env). On Render/Netlify, enter these in the site settings.

# ---- Server (Render)
NODE_ENV=production
# Neon PostgreSQL. Leave empty locally to use the built-in database in data/pg.
DATABASE_URL=
# Your Netlify address, used in SMS and tracking links
PUBLIC_URL=https://your-site.netlify.app
# Sites allowed to call the server from a browser
CORS_ORIGIN=https://your-site.netlify.app
# First manager (Staff ID VIP-M9001), created on an empty database
FIRST_MANAGER_PHONE=0240000000
FIRST_MANAGER_PIN=
FIRST_MANAGER_NAME=Akosua Mensah
# Closed trial: only these numbers can get a login code
TEST_PHONES=0240000000,0550000000
# screen = show login code on screen (trial) · sms = send by SMS
OTP_MODE=screen
# true = show "Test mode" buttons (check in without location, demo drive)
TEST_MODE=true
# mock = test checkout · live = Hubtel (needs HUBTEL_CLIENT_ID, HUBTEL_CLIENT_SECRET, HUBTEL_MERCHANT_ACCOUNT)
HUBTEL_MODE=mock

# ---- Real SMS (optional). Pick one provider.
SMS_PROVIDER=
SMS_SENDER=VIPHopOn
ARKESEL_API_KEY=
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
MNOTIFY_API_KEY=

# ---- Screens (Netlify)
# The Render server address. Leave empty when the server and screens are on the same site.
VITE_API_URL=https://vip-hopon-api.onrender.com
